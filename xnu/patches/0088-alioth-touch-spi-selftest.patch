+/* A command with no data phase (8 = CS assert, 9 = CS deassert). */
+static int
+ts4_spi_simple(vm_offset_t se, unsigned opcode, const char *name)
+{
+	uint32_t irq = 0;
+	unsigned t;
+	if (touch_rd(se, 0x40) & 1u) {
+		ts4_spi_recover(se);
+	}
+	touch_wr(se, TS4_M_IRQ_CLEAR, 0xffffffffu);
+	touch_wr(se, TS4_M_CMD0, opcode << 27);
+	for (t = 0; t < 20000u; ++t) {
+		irq = touch_rd(se, TS4_M_IRQ_STATUS);
+		if (irq & (TS4_M_DONE | TS4_M_ERRORS)) {
+			break;
+		}
+		delay(5);
+	}
+	printf("SWEET TOUCH4: C: test %s: %s irq=%#x status=%#x ios=%#x polls=%u\n", name,
+	    (irq & TS4_M_DONE) && !(irq & TS4_M_ERRORS) ? "ok" : "FAILED", irq,
+	    touch_rd(se, 0x40), touch_rd(se, 0x908), t);
+	touch_wr(se, TS4_M_IRQ_CLEAR, irq);
+	if (!(irq & TS4_M_DONE) || (irq & TS4_M_ERRORS)) {
+		ts4_spi_recover(se);
+		return EIO;
+	}
+	return 0;
+}
