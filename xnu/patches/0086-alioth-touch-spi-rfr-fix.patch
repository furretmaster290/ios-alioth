+/* Cancel (then abort) an active master command and drain the FIFOs. */
+static void
+ts4_spi_recover(vm_offset_t se)
+{
+	unsigned t;
+	touch_wr(se, TS4_M_CMD_CTRL, 1u << 2); /* cancel */
+	for (t = 0; t < 4000u && (touch_rd(se, 0x40) & 1u); ++t) {
+		delay(5);
+	}
+	if (touch_rd(se, 0x40) & 1u) {
+		touch_wr(se, TS4_M_CMD_CTRL, 1u << 1); /* abort */
+		for (t = 0; t < 4000u && (touch_rd(se, 0x40) & 1u); ++t) {
+			delay(5);
+		}
+	}
+	ts4_spi_flush_rx(se);
+	touch_wr(se, TS4_M_IRQ_CLEAR, 0xffffffffu);
+	printf("SWEET TOUCH4: C: recover: status=%#x tx_fifo=%#x irq=%#x\n",
+	    touch_rd(se, 0x40), touch_rd(se, 0x800), touch_rd(se, TS4_M_IRQ_STATUS));
+}
