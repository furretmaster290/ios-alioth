+#if defined(UMI)
+/*
+ * ALIOTH step 1 (boot-arg sweettouch=2): FocalTech SPI touch bring-up
+ * diagnostics for POCO F3.  The panel's touch controller sits on QUP0 SE4
+ * (spi@990000: GPIO8-11 = qup4, reset GPIO33, IRQ GPIO39) and is powered
+ * from PM8150A L10 (vdd, 3.0-3.3 V) and L1 (vcc_i2c, 1.8 V).  No SPI
+ * protocol is spoken here.  Phase A (rails, reset, IRQ pad sampling)
+ * touches only RPMh and TLMM.  Phase B (sweettouchse=1) clocks SE4 and
+ * prints its GENI registers; it is opt-in because an SE access with its
+ * clocks off stalls the interconnect.
+ */
+#define TS4_TLMM_NORTH_PA 0x0f900000u /* TLMM 0xf000000 + NORTH tile 0x900000 */
+#define TS4_TLMM_SOUTH_PA 0x0f500000u /* TLMM 0xf000000 + SOUTH tile 0x500000 */
+#define TS4_SE_PA         0x00990000u /* qupv3_0 SE4 */
+#define TS4_GPIO_SPI0     8           /* qup4, GPIO8..11 */
+#define TS4_GPIO_RESET    33
+#define TS4_GPIO_IRQ      39
+#define TS4_RCG           0x174d0u    /* gcc_qupv3_wrap0_s4_clk_src */
+#define TS4_RCG_HALT      0x174ccu    /* gcc_qupv3_wrap0_s4_clk halt */
+#define TS4_GCC_VOTE      0x52008u
+/* wrap0: m_ahb(6) s_ahb(7) core(8) core_2x(9) s4(14) */
+#define TS4_GCC_MASK      ((1u << 6) | (1u << 7) | (1u << 8) | (1u << 9) | (1u << 14))
+
+static void
+ts4_gpio(vm_offset_t base, unsigned pin, unsigned mux, unsigned pull,
+    unsigned drive, bool out, bool high)
+{
+	uint32_t off = pin * 0x1000u;
+	uint32_t cfg = touch_rd(base, off);
+	if (out) {
+		touch_wr(base, off + 4u,
+		    (touch_rd(base, off + 4u) & ~2u) | (high ? 2u : 0u));
+	}
+	cfg &= ~0x3ffu;
+	cfg |= (mux << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
+	touch_wr(base, off, cfg);
+}
+
+static void
+ts4_phase_b(vm_offset_t gcc)
+{
+	uint32_t vote = touch_rd(gcc, TS4_GCC_VOTE);
+	printf("SWEET TOUCH4: B: gcc vote before=%#x\n", vote);
+	touch_wr(gcc, TS4_GCC_VOTE, vote | TS4_GCC_MASK);
+	/* s_ahb has hardware clock gating on bit 1; Linux clears it first. */
+	touch_wr(gcc, 0x17008, touch_rd(gcc, 0x17008) & ~(1u << 1));
+	uint32_t dfs = touch_rd(gcc, TS4_RCG + 0x14u);
+	uint32_t cfg = touch_rd(gcc, TS4_RCG + 4u);
+	printf("SWEET TOUCH4: B: rcg=%#x cfg=%#x dfs=%#x vote=%#x\n",
+	    touch_rd(gcc, TS4_RCG), cfg, dfs, touch_rd(gcc, TS4_GCC_VOTE));
+	if (dfs & 1u) {
+		touch_wr(gcc, TS4_RCG + 0x14u, dfs & ~1u);
+		dfs = touch_rd(gcc, TS4_RCG + 0x14u);
+		printf("SWEET TOUCH4: B: DFS disabled (ctrl now %#x), using XO/1\n", dfs);
+	}
+	if (dfs & 1u) {
+		printf("SWEET TOUCH4: B: DFS still on; stopping\n");
+		return;
+	}
+	/* XO parent 0, HID divider 1 => 19.2 MHz. */
+	cfg = (cfg & ~(0x371fu | (1u << 20))) | 1u;
+	touch_wr(gcc, TS4_RCG + 4u, cfg);
+	touch_wr(gcc, TS4_RCG, touch_rd(gcc, TS4_RCG) | 1u);
+	if (!touch_wait_clear(gcc, TS4_RCG, 1u)) {
+		printf("SWEET TOUCH4: B: RCG update timeout\n");
+		return;
+	}
+	const uint32_t halts[] = {0x17004, 0x17008, 0x23000, 0x23008, TS4_RCG_HALT};
+	for (unsigned i = 0; i < sizeof(halts) / sizeof(halts[0]); ++i) {
+		if (!touch_wait_clear(gcc, halts[i], 1u << 31)) {
+			printf("SWEET TOUCH4: B: GCC branch %#x halted (%#x); not touching SE4\n",
+			    halts[i], touch_rd(gcc, halts[i]));
+			return;
+		}
+	}
+	printf("SWEET TOUCH4: B: clocks ready; reading SE4 registers\n");
+	vm_offset_t se = ml_io_map(TS4_SE_PA, 0x4000);
+	if (!se) {
+		printf("SWEET TOUCH4: B: SE4 mapping failed\n");
+		return;
+	}
+	uint32_t fw = touch_rd(se, 0x68);
+	printf("SWEET TOUCH4: B: SE4 status=%#x clk_ctrl=%#x if_disable=%#x fw=%#x proto=%u\n",
+	    touch_rd(se, 0x40), touch_rd(se, 0x60), touch_rd(se, 0x64), fw,
+	    (fw >> 8) & 0xffu);
+	printf("SWEET TOUCH4: B: SE4 clk_sel=%#x dma_en=%#x hw_tx=%#x hw_rx=%#x\n",
+	    touch_rd(se, 0x7c), touch_rd(se, 0x258), touch_rd(se, 0xe24),
+	    touch_rd(se, 0xe28));
+	printf("SWEET TOUCH4: B: SE4 is %s (proto 1 = SPI, 2 = UART, 3 = I2C)\n",
+	    ((fw >> 8) & 0xffu) == 1u ? "SPI firmware, as the DT expects" : "NOT loaded as SPI");
+}
+
+static void
+touch_spi_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 45;
+	int phase_b = 0;
+	(void)arg;
+	(void)result;
+	(void)PE_parse_boot_argn("sweettouchdelay", &delay_s, sizeof(delay_s));
+	(void)PE_parse_boot_argn("sweettouchse", &phase_b, sizeof(phase_b));
+	printf("SWEET TOUCH4: alioth FocalTech SPI diagnostic starting in %u s (phase B %s)\n",
+	    delay_s, phase_b ? "on" : "off");
+	touch_wait(delay_s * 1000u);
+	vm_offset_t north = ml_io_map(TS4_TLMM_NORTH_PA, 0x10000);
+	vm_offset_t south = ml_io_map(TS4_TLMM_SOUTH_PA, 0x30000);
+	if (!north || !south) {
+		printf("SWEET TOUCH4: TLMM mapping failed\n");
+		goto out;
+	}
+	printf("SWEET TOUCH4: A: pads before: spi0..3 cfg=%#x %#x %#x %#x reset cfg=%#x io=%#x irq cfg=%#x io=%#x\n",
+	    touch_rd(north, (TS4_GPIO_SPI0 + 0) * 0x1000u), touch_rd(north, (TS4_GPIO_SPI0 + 1) * 0x1000u),
+	    touch_rd(north, (TS4_GPIO_SPI0 + 2) * 0x1000u), touch_rd(north, (TS4_GPIO_SPI0 + 3) * 0x1000u),
+	    touch_rd(south, TS4_GPIO_RESET * 0x1000u), touch_rd(south, TS4_GPIO_RESET * 0x1000u + 4u),
+	    touch_rd(south, TS4_GPIO_IRQ * 0x1000u), touch_rd(south, TS4_GPIO_IRQ * 0x1000u + 4u));
+	/* Hold the IC in reset (active low) and make the IRQ pad a pulled-up input. */
+	ts4_gpio(south, TS4_GPIO_IRQ, 0, 3, 2, false, false);
+	ts4_gpio(south, TS4_GPIO_RESET, 0, 0, 2, true, false);
+	int e1 = sweet_rpmh_vreg_enable("ldoc1", 1800);
+	int e10 = sweet_rpmh_vreg_enable("ldoc10", 3000);
+	printf("SWEET TOUCH4: A: rails ldoc1=%d ldoc10=%d (0 = voted on)\n", e1, e10);
+	touch_wait(10);
+	/* SPI pins to qup4 (function 1), no bias, 6 mA. */
+	for (unsigned i = 0; i < 4; ++i) {
+		ts4_gpio(north, TS4_GPIO_SPI0 + i, 1, 0, 2, false, false);
+	}
+	touch_wait(5);
+	ts4_gpio(south, TS4_GPIO_RESET, 0, 0, 2, true, true); /* release reset */
+	/* Sample the IRQ pad for ~1.5 s after reset release. */
+	unsigned level = touch_rd(south, TS4_GPIO_IRQ * 0x1000u + 4u) & 1u;
+	unsigned start = level, falls = 0, lows = 0, first_fall_ms = 0;
+	for (unsigned ms = 0; ms < 1500; ++ms) {
+		unsigned now = touch_rd(south, TS4_GPIO_IRQ * 0x1000u + 4u) & 1u;
+		if (level && !now) {
+			++falls;
+			if (!first_fall_ms) {
+				first_fall_ms = ms + 1;
+			}
+		}
+		if (!now) {
+			++lows;
+		}
+		level = now;
+		delay(1000);
+	}
+	printf("SWEET TOUCH4: A: IRQ(GPIO%d) pad start=%u end=%u falling-edges=%u low-ms=%u first-fall-ms=%u\n",
+	    TS4_GPIO_IRQ, start, level, falls, lows, first_fall_ms);
+	printf("SWEET TOUCH4: A: pads after: spi0..3 cfg=%#x %#x %#x %#x reset cfg=%#x io=%#x irq cfg=%#x io=%#x\n",
+	    touch_rd(north, (TS4_GPIO_SPI0 + 0) * 0x1000u), touch_rd(north, (TS4_GPIO_SPI0 + 1) * 0x1000u),
+	    touch_rd(north, (TS4_GPIO_SPI0 + 2) * 0x1000u), touch_rd(north, (TS4_GPIO_SPI0 + 3) * 0x1000u),
+	    touch_rd(south, TS4_GPIO_RESET * 0x1000u), touch_rd(south, TS4_GPIO_RESET * 0x1000u + 4u),
+	    touch_rd(south, TS4_GPIO_IRQ * 0x1000u), touch_rd(south, TS4_GPIO_IRQ * 0x1000u + 4u));
+	if (phase_b) {
+		vm_offset_t gcc = ml_io_map(TOUCH_GCC_PA, 0x60000);
+		if (gcc) {
+			ts4_phase_b(gcc);
+		} else {
+			printf("SWEET TOUCH4: B: GCC mapping failed\n");
+		}
+	} else {
+		printf("SWEET TOUCH4: B: skipped (add sweettouchse=1 to read SE4 registers)\n");
+	}
+	printf("SWEET TOUCH4: done\n");
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+#endif /* UMI */
