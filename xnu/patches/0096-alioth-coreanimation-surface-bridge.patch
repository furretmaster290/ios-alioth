diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -5568,6 +5568,54 @@
  * Note:	The argument and environment vectors are user space pointers
  *		to arrays of user space pointers.
  */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * SWEET: boot-arg sweetinject=LIBRARY:NAME[,NAME...] -- every program whose
+ * file name is one of the NAMEs is started with DYLD_INSERT_LIBRARIES=LIBRARY
+ * in its environment (the CoreAnimation bridge in backboardd). launchd drops
+ * DYLD_ variables from job descriptions, so the kernel adds this one; dyld
+ * honours it because sweet_amfi.c's "AMFI" policy allows it while sweetinject
+ * is set. After HackiOS's kern.exec_inject (bsd/kern/kern_exec.c there).
+ */
+static bool
+sweet_exec_inject(struct image_params *imgp, char *env, size_t size)
+{
+	char conf[200];
+	const char *path = imgp->ip_strings + strlen(EXECUTABLE_KEY), *name = path, *word;
+	size_t namelen, liblen = 0;
+
+	if (!PE_parse_boot_argn("sweetinject", conf, sizeof(conf)) ||
+	    strncmp(imgp->ip_strings, EXECUTABLE_KEY, strlen(EXECUTABLE_KEY)) != 0) {
+		return false;
+	}
+	while (conf[liblen] != 0 && conf[liblen] != ':') {
+		liblen++;
+	}
+	if (conf[liblen] != ':' || liblen == 0) {
+		return false;
+	}
+	for (const char *c = path; *c != 0; c++) {
+		if (*c == '/') {
+			name = c + 1;
+		}
+	}
+	namelen = strlen(name);
+	for (word = conf + liblen + 1; *word != 0;) {
+		size_t len = 0;
+
+		while (word[len] != 0 && word[len] != ',') {
+			len++;
+		}
+		if (len == namelen && namelen != 0 && strncmp(word, name, len) == 0) {
+			snprintf(env, size, "DYLD_INSERT_LIBRARIES=%.*s", (int)liblen, conf);
+			return true;
+		}
+		word += len + (word[len] == ',');
+	}
+	return false;
+}
+#endif
+
