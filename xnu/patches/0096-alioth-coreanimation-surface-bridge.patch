 static mac_policy_handle_t sweet_amfi_mac_handle;
 
+/*
+ * dyld asks AMFI what it may do for the process it starts (mac_syscall("AMFI",
+ * 0x5a, { flags in, pointer to flags out }), amfi_check_dyld_policy_self()).
+ * With no policy of that name it gets ENOPOLICY and, on iOS, allows nothing:
+ * DYLD_INSERT_LIBRARIES is ignored. With boot-arg sweetinject set (the
+ * programs kern_exec.c starts with a library inserted) this answers
+ * everything allowed, as HackiOS's AMFI stand-in does (kern_minimac.c);
+ * without it, and for every other request, ENOPOLICY as before.
+ */
+#define AMFI_SYSCALL_CHECK_DYLD_POLICY  0x5a
+#define AMFI_DYLD_OUTPUT_ALLOW_ALL      0xffULL
+
+static int
+sweet_amfi_dyld_syscall(__unused struct proc *p, int call, user_addr_t arg)
+{
+	struct {
+		uint64_t input_flags;
+		user_addr_t output_flags;
+	} args;
+	uint64_t flags = AMFI_DYLD_OUTPUT_ALLOW_ALL;
+	char inject[8];
+	int error;
+
+	if (call != AMFI_SYSCALL_CHECK_DYLD_POLICY || !PE_parse_boot_argn("sweetinject", inject, sizeof(inject))) {
+		return ENOPOLICY;
+	}
+	error = copyin(arg, &args, sizeof(args));
+	if (error == 0) {
+		error = copyout(&flags, args.output_flags, sizeof(flags));
+	}
+	return error;
+}
+
+static const struct mac_policy_ops sweet_amfi_dyld_ops = {
+	.mpo_policy_syscall = sweet_amfi_dyld_syscall,
+};
+
+static struct mac_policy_conf sweet_amfi_dyld_conf = {
+	.mpc_name = "AMFI",
+	.mpc_fullname = "SWEET dyld policy (AMFI's name, request 0x5a only)",
+	.mpc_ops = &sweet_amfi_dyld_ops,
+};
+
+static mac_policy_handle_t sweet_amfi_dyld_handle;
+
 /* Called from bsd_init once MAC policies can register, before any exec. */
 void sweet_amfi_policy_register(void);
 
