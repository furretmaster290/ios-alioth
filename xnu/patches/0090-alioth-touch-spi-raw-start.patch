+/* Dump the interesting parts of the SE4 register file, 4 words per line. */
+static void
+ts4_dump(vm_offset_t se, const char *tag)
+{
+	static const uint32_t ranges[][2] = {
+		{0x000, 0x080}, {0x220, 0x2a0}, {0x600, 0x640},
+		{0x800, 0x820}, {0x900, 0x920}, {0xe00, 0xe40},
+	};
+	for (unsigned r = 0; r < sizeof(ranges) / sizeof(ranges[0]); ++r) {
+		for (uint32_t off = ranges[r][0]; off < ranges[r][1]; off += 16u) {
+			printf("SWEET TOUCH4: D(%s): %03x: %08x %08x %08x %08x\n", tag, off,
+			    touch_rd(se, off), touch_rd(se, off + 4u),
+			    touch_rd(se, off + 8u), touch_rd(se, off + 12u));
+		}
+	}
+}
+
 /* True once the master command is no longer active (or DONE is raised). */
 static bool
 ts4_wait_idle(vm_offset_t se, unsigned polls)
