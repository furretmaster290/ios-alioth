+/*
+ * A directory made by the kernel itself, PATH in kernel memory (bsd/dev/sweet_files.c: the
+ * folders of the files the boot image carries, before launchd starts). Mode as given, owner
+ * root; EEXIST if it is there already.
+ */
+int sweet_kernel_mkdir(const char *path, mode_t mode);
+
+int
+sweet_kernel_mkdir(const char *path, mode_t mode)
+{
+	struct vnode_attr va;
+
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_mode, mode & ACCESSPERMS);
+	return mkdir1at(vfs_context_kernel(), CAST_USER_ADDR_T(path), &va, AT_FDCWD, UIO_SYSSPACE);
+}
