+/*
+ * Touch driver for POCO F3 (sweettouch=3).  Reads register 0x01 (FocalTech
+ * point report) every 8 ms and feeds sweet_hid_touch(); coordinates are the
+ * chip's 15-bit values divided by 8, which is the 1080x2400 pixel space the
+ * HID layer expects.  Report layout per the vendor focaltech_spi driver
+ * (data[] below is buf[1..], i.e. the bytes after the read command):
+ *   data[1] = point count (low nibble), then 6 bytes per point from data[2]:
+ *   +0 event(7:6) | xh(3:0), +1 xl, +2 id(7:4) | yh(3:0), +3 yl, +4 pressure/lsbs, +5 area
+ */
+#define TS4_MAXF 5u
+
+static void
+ts4_touch_loop(vm_offset_t se, vm_offset_t south)
+{
+	uint8_t data[32];
+	uint8_t raw[16];
+	uint32_t active = 0;
+	int lx[TS4_MAXF] = {0}, ly[TS4_MAXF] = {0};
+	unsigned reports = 0, errors = 0, consecutive_err = 0, logged = 0;
+	printf("SWEET TOUCH4: T: touch loop running (poll 8 ms, coords /8, %u fingers)\n", TS4_MAXF);
+	for (;;) {
+		touch_wait(8);
+		memset(data, 0, sizeof(data));
+		int rc = ts4_fts_read(se, 0x01, data, sizeof(data), raw);
+		if (rc != 0) {
+			++errors;
+			++consecutive_err;
+			if (errors <= 8 || (errors % 500) == 0) {
+				printf("SWEET TOUCH4: T: read error rc=%d (errors=%u)\n", rc, errors);
+			}
+			continue;
+		}
+		consecutive_err = 0;
+		unsigned npoints = data[1] & 0x0fu;
+		bool recovery = (npoints == 0x0fu) && data[2] == 0xff && data[3] == 0xff &&
+		    data[4] == 0xff && data[5] == 0xff && data[6] == 0xff;
+		uint32_t mask = 0;
+		int nx[TS4_MAXF] = {0}, ny[TS4_MAXF] = {0};
+		if (!recovery && npoints > 0 && npoints <= 10u) {
+			for (unsigned i = 0; i < TS4_MAXF; ++i) {
+				unsigned base = 6u * i;
+				unsigned id = data[4 + base] >> 4;
+				if (id >= 0x0au) {
+					break; /* empty slot */
+				}
+				if (id >= TS4_MAXF) {
+					continue;
+				}
+				unsigned flag = data[2 + base] >> 6; /* 0 down, 1 up, 2 contact */
+				unsigned xr = ((data[2 + base] & 0x0fu) << 11) + ((unsigned)data[3 + base] << 3) +
+				    ((data[6 + base] & 0xe0u) >> 5);
+				unsigned yr = ((data[4 + base] & 0x0fu) << 11) + ((unsigned)data[5 + base] << 3) +
+				    ((data[6 + base] & 0x1cu) >> 2);
+				if (flag == 1u) {
+					continue; /* lift-off: not in the mask, released below */
+				}
+				mask |= 1u << id;
+				nx[id] = (int)(xr / 8u);
+				ny[id] = (int)(yr / 8u);
+			}
+		}
+		++reports;
+		if (mask != 0 || active != 0) {
+			if (logged < 40) {
+				++logged;
+				printf("SWEET TOUCH4: T: report n=%u mask=%#x active=%#x f0=(%d,%d) irq=%u raw=%02x %02x %02x %02x %02x %02x %02x %02x\n",
+				    npoints, mask, active, nx[0], ny[0],
+				    (unsigned)(touch_rd(south, TS4_GPIO_IRQ * 0x1000u + 4u) & 1u),
+				    raw[0], raw[1], raw[2], raw[3], raw[4], raw[5], raw[6], raw[7]);
+			}
+		}
+		for (unsigned id = 0; id < TS4_MAXF; ++id) {
+			uint32_t bit = 1u << id;
+			if (mask & bit) {
+				if (!(active & bit) || nx[id] != lx[id] || ny[id] != ly[id]) {
+					sweet_hid_touch((int)id, 1, nx[id], ny[id]);
+				}
+				lx[id] = nx[id];
+				ly[id] = ny[id];
+			} else if (active & bit) {
+				sweet_hid_touch((int)id, 0, lx[id], ly[id]);
+			}
+		}
+		active = mask;
+		if (consecutive_err == 0 && (reports % 8000u) == 0) {
+			printf("SWEET TOUCH4: T: alive: %u reports, %u read errors\n", reports, errors);
+		}
+	}
 }
 
