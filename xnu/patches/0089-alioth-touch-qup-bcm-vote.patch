+
+/*
+ * Vote an RPMh BCM (bus clock manager) resource.  Only the QUP core BCM is
+ * allowed: Linux/downstream votes it whenever a QUP serial engine is used, and
+ * the bootloader only votes what it uses itself.  Command format follows
+ * BCM_TCS_CMD(commit, valid, vote_x, vote_y).
+ */
+int
+sweet_rpmh_bcm_vote(const char *res, unsigned vote_x, unsigned vote_y)
+{
+	if (!res || strcmp(res, "QUP0") || vote_x > 0x3fffu || vote_y > 0x3fffu) {
+		printf("SWEET RPMH: bcm vote refused (only QUP0, 14-bit votes)\n");
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup(res, &address, RH_BCM);
+	}
+	if (!error) {
+		const uint32_t offsets[1] = {0};
+		const uint32_t values[1] = {(1u << 30) | (1u << 29) | (vote_x << 14) | vote_y};
+		error = rh_send(address, 1, offsets, values);
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: bcm vote %s failed errno=%d\n", res, error);
+	} else {
+		printf("SWEET RPMH: bcm %s voted x=%u y=%u\n", res, vote_x, vote_y);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
