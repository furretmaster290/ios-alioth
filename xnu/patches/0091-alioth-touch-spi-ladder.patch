 #define TS4_SPI_DIV            4u /* 19.2 MHz / 4 = 4.8 MHz, mode 0, 8-bit */
 #define TS4_FTS_MAX_DATA       16u
 
+/* Groups of init writes that change the firmware's state; sweettouchspiskip bitmask. */
+#define TS4_G_IRQ    1u   /* SE_IRQ_EN/S_IRQ_EN := 0 */
+#define TS4_G_FORCE  2u   /* GENI_FORCE_DEFAULT := 1 */
+#define TS4_G_PACK   4u   /* TX/RX packing + byte granularity */
+#define TS4_G_WLEN   8u   /* SPI word length */
+#define TS4_G_CLK    16u  /* serial clock divider */
+#define TS4_G_MIRQ   32u  /* master IRQ enable mask */
+static unsigned ts4_skip;
+
+static void
+ts4_g_apply(vm_offset_t se, unsigned group)
+{
+	switch (group) {
+	case TS4_G_IRQ:
+		touch_wr(se, TS4_SE_IRQ_EN, 0u); /* like the I2C engine */
+		touch_wr(se, 0x644u, 0u);        /* S_IRQ_EN */
+		break;
+	case TS4_G_FORCE:
+		touch_wr(se, TS4_GENI_FORCE_DEFAULT, 1u);
+		break;
+	case TS4_G_PACK:
+		/* 4 x 8-bit words per FIFO entry, MSB first */
+		touch_wr(se, TS4_GENI_TX_PACK0, 0x0007f8feu);
+		touch_wr(se, TS4_GENI_TX_PACK1, 0x000ffefeu);
+		touch_wr(se, TS4_GENI_RX_PACK0, 0x0007f8feu);
+		touch_wr(se, TS4_GENI_RX_PACK1, 0x000ffefeu);
+		touch_wr(se, TS4_GENI_BYTE_GRAN, 0u);
+		break;
+	case TS4_G_WLEN:
+		touch_wr(se, TS4_SPI_WORD_LEN, (touch_rd(se, TS4_SPI_WORD_LEN) & ~0x3ffu) | (8u - 4u));
+		break;
+	case TS4_G_CLK:
+		touch_wr(se, TS4_GENI_CLK_SEL, 0u);
+		touch_wr(se, TS4_GENI_SER_M_CLK_CFG, (TS4_SPI_DIV << 4) | 1u);
+		break;
+	case TS4_G_MIRQ:
+		touch_wr(se, TS4_M_IRQ_EN, TS4_M_DONE | TS4_M_ERRORS | (1u << 26) | (1u << 27) | (1u << 30));
+		break;
+	default:
+		break;
+	}
+}
+
