-	    touch_rd(se, TS4_GENI_TX_PACK1));
+	/* The writes that actually change the firmware's state, skippable per group. */
+	for (unsigned g = TS4_G_IRQ; g <= TS4_G_MIRQ; g <<= 1) {
+		if (!(ts4_skip & g)) {
+			ts4_g_apply(se, g);
+		}
+	}
+	printf("SWEET TOUCH4: C: SPI init (skip mask %#x): rx_wm=%#x rfr_wm=%#x status=%#x\n",
+	    ts4_skip, touch_rd(se, TS4_RX_WATERMARK), touch_rd(se, TS4_RX_RFR_WATERMARK), touch_rd(se, 0x40));
+	printf("SWEET TOUCH4: C: SPI init: word_len=%#x clk=%#x tx_pack=%#x/%#x irq_en=%#x\n",
+	    touch_rd(se, TS4_SPI_WORD_LEN), touch_rd(se, TS4_GENI_SER_M_CLK_CFG),
+	    touch_rd(se, TS4_GENI_TX_PACK0), touch_rd(se, TS4_GENI_TX_PACK1), touch_rd(se, TS4_SE_IRQ_EN));
 }
 
